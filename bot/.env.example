# WhatsApp Bot (Home Server) Configuration
# Copy to .env (never commit .env or auth_info/)

# Owner WhatsApp number in international format (no +, no spaces)
OWNER_WA_NUMBER=6285816686900

# Cloudflare Worker API URL
WORKER_URL=https://sigma-music-worker.alephsc25.workers.dev

# Shared HMAC secret (must match WEBHOOK_SECRET on Cloudflare Worker)
WEBHOOK_SECRET=ganti-dengan-secret-sama-seperti-di-worker

# Local HTTP server port for receiving Worker webhooks (expose via cloudflared tunnel)
BOT_PORT=3099

# Anti-suspend safety toggles:
# Set to "true" ONLY if you want the bot to auto-reply to customer DMs using Worker AI/RAG.
# Keeping it "false" means the bot ONLY sends booking notifications to OWNER_WA_NUMBER (lowest ban risk).
ENABLE_PUBLIC_AI_REPLY=false

# Delay bounds (milliseconds) for human-like typing & outbound queue spacing
MIN_REPLY_DELAY_MS=1800
MAX_REPLY_DELAY_MS=4200
OUTBOUND_JITTER_MIN_MS=2200
OUTBOUND_JITTER_MAX_MS=5000
